# PANDA SDK Configuration
# ========================
# This file shows the required environment variables.
# Copy to .env and fill with real values for your environment.

# Per-application access token (DEMO — do NOT use in production)
# Required to generate keys: panda init --token <token>
# Register your application at the PANDA portal to get a live token.
PANDA_ACCESS_TOKEN=panda_demo_76d08573d453cdbdb4bf5704d13f8f54d57cd3c47c9b4be2

# Encryption key(s) — generate with: panda init --kid <your-kid>
# Each key is base64-encoded 256-bit (32-byte) value.
# NEVER commit real keys to version control!
PANDA_KEY_DEFAULT_KEY=

# Default key identifier for new writes
PANDA_DEFAULT_KID=default-key

# Telemetry (set to 1 to disable)
# PANDA_TELEMETRY_DISABLED=0

# Database connection (for migration CLI)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=root
# DB_PASSWORD=

PANDA_KEY_TEST_KEY_PHP=
