{
  "name": "jatimprovcsirt/panda-php",
  "description": "PANDA (Private And Secure Data Access) SDK for PHP",
  "license": "MIT",
  "version": "0.2.2",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Bidang Persandian dan Keamanan Informasi - Dinas Komunikasi dan Informatika Provinsi Jawa Timur",
      "email": "csirt@jatimprov.go.id"
    }
  ],
  "bin": [
    "bin/panda"
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "psr/log": "^2.0 || ^3.0",
    "symfony/console": "^6.0 || ^7.0",
    "infisical/infisical-php-sdk": "^1.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Panda\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Panda\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Panda\\Integrations\\Laravel\\PandaServiceProvider"
      ]
    }
  }
}